generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id          Int      @id @default(autoincrement())
  gameDate    DateTime
  league      String
  market      String
  selection   String
  oddsAmerican Int
  stakeUnits  Float
  result      String
  createdAt   DateTime @default(now())
}

model BankrollEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Float
  type        String
  note        String?
  createdAt   DateTime @default(now())
}

model StrategyNote {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  tag         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FreeStat {
  id             Int      @id @default(autoincrement())
  league         String
  conference     String?
  gameDate       DateTime
  team           String
  opponent       String
  points         Int
  opponentPoints Int?
  rebounds       Int?
  assists        Int?
  yards          Int?
  spread         Float?
  atsResult      String?
  won            Boolean?
  teamRank       Int?
  opponentRank   Int?
  bubbleStatus   String?
  autoBidStatus  String?
  // Basketball box score
  fgm          Int?
  fga          Int?
  threepm      Int?
  threepa      Int?
  ftm          Int?
  fta          Int?
  offRebounds  Int?
  defRebounds  Int?
  steals       Int?
  blocks       Int?
  turnovers    Int?

  // NFL box score
  passingYards      Int?
  rushingYards      Int?
  opponentYards     Int?
  turnoversFor      Int?
  turnoversAgainst  Int?
  thirdDownConv     Int?
  thirdDownAtt      Int?
  redZoneConv       Int?
  redZoneAtt        Int?
  timeOfPossession  Float?

  // Universal
  homeAway  String?
  hits      Int?
  errors    Int?

  source             String
  sourceEventId      String?
  gameStatus         String?
  completionEvidence String?
  createdAt          DateTime @default(now())

  @@index([league, gameDate])
  @@index([league, conference])
  @@index([team, gameDate])
}

// ─── Agent layer ─────────────────────────────────────────────────────────────
// Picks generated by the Claude analyst, graded outcomes, and consolidated
// learnings produced by the weekly dream job.

model AgentPick {
  id             Int       @id @default(autoincrement())
  runId          String    // groups all picks from one analyze run
  league         String    // NBA | MLB | NCAAB
  gameDate       DateTime
  // Stable per-game identifier (the Odds API event.id, copied by the analyst
  // from get_odds). Distinguishes split doubleheaders that share a matchup and
  // a commence_time — which (league, gameDate, market, selection) cannot. Added
  // 2026-06-11 as the EXPAND phase; the unique key still keys on gameDate until
  // eventId is verified populated, then a follow-up swaps it to eventId.
  eventId        String?
  matchup        String    // "Yankees @ Red Sox"
  market         String    // moneyline | spread | total | prop
  selection      String    // "Yankees -130" | "Aaron Judge over 1.5 HR"
  oddsAmerican   Int
  modelProb      Float     // model's fair probability for the pick
  marketProb     Float     // implied prob from oddsAmerican
  edge           Float     // modelProb - marketProb
  kellyStakeUnits Float    // recommended stake (capped fraction-Kelly)
  confidence     Int       // 1-100, agent's stated confidence
  thesis         String    // short paragraph
  invalidation   String    // what would make this pick wrong
  signals        String    // JSON array of signal strings
  toolsUsed      String    // JSON array of tool names called during analysis
  modelId        String    // anthropic model id used
  createdAt      DateTime  @default(now())

  outcome AgentOutcome?

  // CLV tracking (Closing Line Value): captured by the clv-tracker script
  // shortly before game time. Positive cents = we picked at better price than
  // closing line (good — true edge indicator). Negative = we paid worse.
  closingOddsAmerican Int?
  // DEPRECATED — retained for audit/history only. Naive `pickedOdds -
  // closingOdds` subtraction, which is invalid across the ±100 boundary
  // (+100 and −100 are both 50% but subtract to 200). Sign is trustworthy,
  // magnitude is not. Nothing should make a decision on this column; read
  // clvProbPoints instead.
  clvCents            Int?
  // CLV in PROBABILITY POINTS (positive = we took a longer price than the
  // close). The metric of record. Float because real moves are fractional —
  // the +102 → −104 case is 1.48pp, which an Int column would truncate to 1.
  clvProbPoints       Float?
  clvCapturedAt       DateTime?
  // Minutes-before-tip at which the current clvCents reading was taken. A later
  // sweep only overwrites clvCents if it is CLOSER to tip than this (so the
  // captured value converges on the true closing line instead of freezing on
  // the first ~85-min-pre-tip reading). NULL until the first valid reading.
  clvReadingMinutesBeforeTip Int?
  // True once clvCents is frozen (pick went in-play, or a sweep ran inside the
  // tight closing window). The capture query skips finalized rows; non-final
  // rows with a reading remain eligible for a closer-to-tip overwrite.
  clvFinal            Boolean  @default(false)

  // Player-prop fields (null for team-level markets). When market = "prop",
  // all four must be populated; the autograder uses these to look up the
  // player's box-score line and compare to `line` for over/under resolution.
  // CLV is not meaningful on props (thin market-making — see paper trial
  // criteria), so clvCents stays null for prop picks.
  player    String?  // canonical player name from get_player_props
  propType  String?  // e.g. player_points, batter_runs_scored
  line      Float?   // numeric prop line
  side      String?  // "over" | "under"

  @@index([league, gameDate])
  @@index([runId])
  // Idempotency: if cron retries fire two orchestrator runs that both produce
  // the same pick on the same day, only the first lands. Bankroll guard's
  // same-game dedup is per-run; this is the cross-run defense.
  @@unique([league, gameDate, market, selection], name: "uniq_pick_per_game_market")
}

model AgentOutcome {
  id             Int       @id @default(autoincrement())
  pickId         Int       @unique
  pick           AgentPick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  result         String    // win | loss | push | void | pending
  actualOutcome  String?   // freeform: actual final score, stat line, etc.
  unitsPnl       Float?    // net units (uses oddsAmerican to compute)
  notes          String?
  gradedAt       DateTime  @default(now())

  @@index([result])
}

model AgentMemory {
  id          Int       @id @default(autoincrement())
  type        String    // rule | pattern | bias | correction
  scope       String    // ALL | NBA | MLB | NCAAB | book:draftkings | etc.
  rule        String    // the canonical statement of the learning
  reasoning   String    // why this was concluded
  weight      Float     @default(1.0) // 0-1 confidence in the rule
  evidence    String    // JSON: pickIds + outcomes that support it
  supersedes  Int?      // id of older memory this replaces (set by dream)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scope, active])
  @@index([type, active])
}

// Snapshot of model-derived picks (market heuristic, scraped player props)
// captured at the moment they were displayed on the dashboard. Lets us track
// historical performance per source AND give the dream agent more data to
// learn from beyond just the bot's own picks.
model ModelPickSnapshot {
  id             Int       @id @default(autoincrement())
  source         String    // market | prop_nba | prop_mlb
  league         String    // NBA | MLB
  snapshotDate   String    // YYYY-MM-DD (UTC), used for dedup
  // Common
  matchup        String?   // game-level picks
  market         String    // moneyline | spread | total | player_points | ...
  selection      String    // canonical pick string (team or player+side)
  line           Float?
  oddsAmerican   Int?
  confidence     Int?
  edge           Float?
  rationaleSignals String  // JSON array of strings
  // Prop-specific
  player         String?
  team           String?
  opponent       String?
  propType       String?   // copy of market for clarity (player_points, etc)
  // Outcome (filled by grader, nullable until then)
  result         String?   // win | loss | push | void | pending
  actualValue    Float?    // actual final value (e.g., player's pts scored)
  notes          String?
  gradedAt       DateTime?

  createdAt      DateTime  @default(now())

  @@unique([source, snapshotDate, market, selection, player])
  @@index([source, snapshotDate])
  @@index([league, result])
}

// Per-run metadata so the dashboard can compute critic kill rate, bankroll
// drop rate, and total pick count over time. Written by the orchestrator after
// the post-pipeline completes.
model AgentRun {
  id                Int       @id @default(autoincrement())
  runId             String    @unique
  league            String
  rawAnalystPicks   Int       // count from analyst.ts before grader/critic
  graderKept        Int       // after the local pick-rubric grader
  criticKilled      Int
  criticWeakened    Int
  bankrollDropped   Int
  finalPickCount    Int
  totalUnits        Float
  bankrollFlags     String    // JSON array
  parseFailed       Boolean   @default(false)
  persistOk         Boolean   @default(true)
  modelId           String
  createdAt         DateTime  @default(now())

  @@index([league, createdAt])
}

model AgentDreamRun {
  id            Int       @id @default(autoincrement())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  status        String    // running | completed | failed
  picksReviewed Int       @default(0)
  memoriesAdded Int       @default(0)
  memoriesRetired Int     @default(0)
  modelId       String
  notes         String?
  error         String?
}

// ── Kalshi favorite-longshot paper trail ($10k virtual book) ───────────────
// Timestamps stored as ISO strings (not DateTime) so the tables can be created
// with plain DDL on Turso without DateTime serialization mismatch.
model KalshiPaperPosition {
  id          Int     @id @default(autoincrement())
  ticker      String  @unique
  eventTicker String
  category    String
  title       String
  side        String  // always "yes" (favorite side) for v1
  entryPrice  Float   // dollars 0-1 (maker fill assumed at the bid)
  contracts   Int
  costUsd     Float
  status      String  // open | closed
  result      String? // yes | no (at settlement)
  pnlUsd      Float?
  openedAt    String  // ISO
  closedAt    String? // ISO
  closeTime   String  // market close time, ISO
  // Fill-reality tracking: the engine assumes every resting bid fills; these
  // record whether the bid verifiably traded through on the candle path.
  fillCheckedAt   String? // ISO — how far the entry→close window has been checked
  fillConfirmedAt String? // ISO — first trade-through of the entry bid, if any
  // Verdict instrumentation (KALSHI_PAPER_SPEC.md) — additive, rule untouched.
  askAtEntry      Float?  // yes_ask at entry → taker counterfactual at settle
  feeType         String? // series fee_type — "quadratic" (maker free) | "quadratic_with_maker_fees"
}

// ── PEAD stock paper book (Experiment No. 3, $10k virtual) ─────────────────
// Long extreme positive EPS surprises, hold 28d, benchmark vs SPY.
// Orders simulated on Alpaca paper; this table is the book of record for
// dates, surprises, and the SPY benchmark legs. ISO-string timestamps for
// the same Turso plain-DDL reason as the Kalshi tables.
model StockPaperPosition {
  id           Int     @id @default(autoincrement())
  symbol       String
  reportDate   String  // YYYY-MM-DD of the earnings report
  epsEstimate  Float
  epsActual    Float
  surprisePct  Float
  side         String  // "long" (v1)
  qty          Float
  entryPrice   Float
  costUsd      Float
  entrySpy     Float?
  exitPrice    Float?
  exitSpy      Float?
  pnlUsd       Float?
  excessRetPct Float?  // vs SPY over the identical window — THE metric
  status       String  // open | closed
  openedAt     String  // ISO
  exitDue      String  // ISO — openedAt + hold period
  closedAt     String? // ISO
  entryOrderId String?
  exitOrderId  String?
  // Revenue legs from the same Finnhub report — captured so the verdict can
  // split drift by revenue-confirmed beats (the documented PEAD moderator).
  revEstimate  Float?
  revActual    Float?
  // Watchdog annotation (JSON string): artifact risk, revenue confirmation,
  // note. Label-only — never used by the trading rule.
  annotation   String?
  // Overnight decomposition legs (captured at settle from daily bars) — lets
  // the verdict split drift into overnight vs intraday (Chan–Marsh 2024).
  entryDayClose Float? // close of the entry session
  nextOpen      Float? // open of the following session

  @@unique([symbol, reportDate])
}

model StockPaperSnapshot {
  id              Int     @id @default(autoincrement())
  ts              String  // ISO
  equityUsd       Float
  cashUsd         Float
  exposureUsd     Float
  realizedPnlUsd  Float
  openCount       Int
  closedCount     Int
  avgExcessRetPct Float?
}

model KalshiPaperLedgerSnapshot {
  id             Int    @id @default(autoincrement())
  ts             String // ISO
  cashUsd        Float
  exposureUsd    Float
  equityUsd      Float
  realizedPnlUsd Float
  openCount      Int
  closedCount    Int
  wins           Int
  losses         Int
}

// GLOBAL daily spend governor for "The Sharp" public chatbot (/api/chat).
// This is the source of truth for the day's model token budget — it MUST be
// global (one row per UTC date, shared across every serverless instance and
// the Discord/Actions runners), not per-process, because /api/chat is a public
// endpoint spending real Anthropic tokens. Per-IP and per-session caps are
// best-effort in-memory abuse mitigation; THIS row is the hard money ceiling.
// Increments are single atomic UPDATE statements (no read-modify-write in app
// code) so concurrent requests can't lose a write.
model ChatSpendCounter {
  // UTC date, YYYY-MM-DD. One row per day; the natural primary key.
  utcDate    String   @id
  // Approximate tokens (input + output) charged against the day's ceiling.
  tokensUsed Int      @default(0)
  // Number of model calls made today — a coarse secondary guard.
  modelCalls Int      @default(0)
  updatedAt  DateTime @updatedAt
}
