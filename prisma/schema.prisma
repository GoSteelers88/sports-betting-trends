generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id          Int      @id @default(autoincrement())
  gameDate    DateTime
  league      String
  market      String
  selection   String
  oddsAmerican Int
  stakeUnits  Float
  result      String
  createdAt   DateTime @default(now())
}

model BankrollEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Float
  type        String
  note        String?
  createdAt   DateTime @default(now())
}

model StrategyNote {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  tag         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FreeStat {
  id             Int      @id @default(autoincrement())
  league         String
  conference     String?
  gameDate       DateTime
  team           String
  opponent       String
  points         Int
  opponentPoints Int?
  rebounds       Int?
  assists        Int?
  yards          Int?
  spread         Float?
  atsResult      String?
  won            Boolean?
  teamRank       Int?
  opponentRank   Int?
  bubbleStatus   String?
  autoBidStatus  String?
  // Basketball box score
  fgm          Int?
  fga          Int?
  threepm      Int?
  threepa      Int?
  ftm          Int?
  fta          Int?
  offRebounds  Int?
  defRebounds  Int?
  steals       Int?
  blocks       Int?
  turnovers    Int?

  // NFL box score
  passingYards      Int?
  rushingYards      Int?
  opponentYards     Int?
  turnoversFor      Int?
  turnoversAgainst  Int?
  thirdDownConv     Int?
  thirdDownAtt      Int?
  redZoneConv       Int?
  redZoneAtt        Int?
  timeOfPossession  Float?

  // Universal
  homeAway  String?
  hits      Int?
  errors    Int?

  source             String
  sourceEventId      String?
  gameStatus         String?
  completionEvidence String?
  createdAt          DateTime @default(now())

  @@index([league, gameDate])
  @@index([league, conference])
  @@index([team, gameDate])
}

// ─── Agent layer ─────────────────────────────────────────────────────────────
// Picks generated by the Claude analyst, graded outcomes, and consolidated
// learnings produced by the weekly dream job.

model AgentPick {
  id             Int       @id @default(autoincrement())
  runId          String    // groups all picks from one analyze run
  league         String    // NBA | MLB | NCAAB
  gameDate       DateTime
  matchup        String    // "Yankees @ Red Sox"
  market         String    // moneyline | spread | total | prop
  selection      String    // "Yankees -130" | "Aaron Judge over 1.5 HR"
  oddsAmerican   Int
  modelProb      Float     // model's fair probability for the pick
  marketProb     Float     // implied prob from oddsAmerican
  edge           Float     // modelProb - marketProb
  kellyStakeUnits Float    // recommended stake (capped fraction-Kelly)
  confidence     Int       // 1-100, agent's stated confidence
  thesis         String    // short paragraph
  invalidation   String    // what would make this pick wrong
  signals        String    // JSON array of signal strings
  toolsUsed      String    // JSON array of tool names called during analysis
  modelId        String    // anthropic model id used
  createdAt      DateTime  @default(now())

  outcome AgentOutcome?

  @@index([league, gameDate])
  @@index([runId])
}

model AgentOutcome {
  id             Int       @id @default(autoincrement())
  pickId         Int       @unique
  pick           AgentPick @relation(fields: [pickId], references: [id], onDelete: Cascade)
  result         String    // win | loss | push | void | pending
  actualOutcome  String?   // freeform: actual final score, stat line, etc.
  unitsPnl       Float?    // net units (uses oddsAmerican to compute)
  notes          String?
  gradedAt       DateTime  @default(now())

  @@index([result])
}

model AgentMemory {
  id          Int       @id @default(autoincrement())
  type        String    // rule | pattern | bias | correction
  scope       String    // ALL | NBA | MLB | NCAAB | book:draftkings | etc.
  rule        String    // the canonical statement of the learning
  reasoning   String    // why this was concluded
  weight      Float     @default(1.0) // 0-1 confidence in the rule
  evidence    String    // JSON: pickIds + outcomes that support it
  supersedes  Int?      // id of older memory this replaces (set by dream)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scope, active])
  @@index([type, active])
}

model AgentDreamRun {
  id            Int       @id @default(autoincrement())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  status        String    // running | completed | failed
  picksReviewed Int       @default(0)
  memoriesAdded Int       @default(0)
  memoriesRetired Int     @default(0)
  modelId       String
  notes         String?
  error         String?
}
