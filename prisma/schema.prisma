generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id          Int      @id @default(autoincrement())
  gameDate    DateTime
  league      String
  market      String
  selection   String
  oddsAmerican Int
  stakeUnits  Float
  result      String
  createdAt   DateTime @default(now())
}

model BankrollEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Float
  type        String
  note        String?
  createdAt   DateTime @default(now())
}

model StrategyNote {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  tag         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FreeStat {
  id        Int      @id @default(autoincrement())
  league    String
  gameDate  DateTime
  team      String
  opponent  String
  points    Int
  rebounds  Int?
  assists   Int?
  yards     Int?
  source    String
  createdAt DateTime @default(now())

  @@index([league, gameDate])
}
