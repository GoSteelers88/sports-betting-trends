generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id          Int      @id @default(autoincrement())
  gameDate    DateTime
  league      String
  market      String
  selection   String
  oddsAmerican Int
  stakeUnits  Float
  result      String
  createdAt   DateTime @default(now())
}

model BankrollEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime
  amount      Float
  type        String
  note        String?
  createdAt   DateTime @default(now())
}

model StrategyNote {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  tag         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FreeStat {
  id             Int      @id @default(autoincrement())
  league         String
  conference     String?
  gameDate       DateTime
  team           String
  opponent       String
  points         Int
  opponentPoints Int?
  rebounds       Int?
  assists        Int?
  yards          Int?
  spread         Float?
  atsResult      String?
  won            Boolean?
  teamRank       Int?
  opponentRank   Int?
  bubbleStatus   String?
  autoBidStatus  String?
  source         String
  createdAt      DateTime @default(now())

  @@index([league, gameDate])
  @@index([league, conference])
  @@index([team, gameDate])
}
