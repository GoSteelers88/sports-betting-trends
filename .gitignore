# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# prisma local db
prisma/*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

data/raw/ncaab/latest_espn_ncaab.json
data/raw/mlb/latest_espn_mlb.json
scripts/python/__pycache__/

.vercel

# Kalshi autopilot runtime/sensitive data
data/processed/kalshi-state.json
data/processed/kalshi-trades.jsonl
data/processed/kalshi-price-history.json
data/processed/backtest-results.json
data/processed/latest-odds-api*.json
# Allow odds files that the agent-run workflow explicitly allowlists for
# commit. Tracked files (NBA, MLB, NCAAB, NHL, top soccer leagues) bypass
# the ignore above because they pre-date the rule. New files need explicit
# exceptions or `git add` silently skips them — that's why the first WNBA
# run modeled 4 games but the auto-publish commit landed without the odds
# file, leaving the dashboard's loadOdds("WNBA") empty.
!data/processed/latest-odds-api-basketball_wnba.json

# Compiled script output
scripts/*.js

# Autopilot runtime files
autopilot.log
autopilot.pid

# Debug / one-off scripts
analyze*.js
check-*.js
check-*.mjs
test-order*.mjs
watch-*.mjs
reset-state.mjs
prisma/prisma/

.vercel
data/backtest/
