{
  "name": "sports-betting-trends",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "ingest:context": "tsx scripts/ingest-context.ts",
    "ingest:free": "tsx scripts/ingest-free-stats.ts",
    "ingest:polymarket": "tsx scripts/ingest-polymarket.ts",
    "ingest:odds": "tsx scripts/ingest-odds-api.ts",
    "ingest:props": "tsx scripts/ingest-props.ts",
    "setup:python": "python -m pip install -r scripts/python/requirements.txt",
    "backtest:props": "python scripts/python/backtest.py",
    "ingest:kalshi": "tsx scripts/ingest-kalshi.ts",
    "test:kalshi": "tsx scripts/test-kalshi.ts",
    "ingest:all": "npm run ingest:context && npm run ingest:odds && npm run ingest:free && npm run ingest:kalshi",
    "validate:latest-games": "tsx scripts/validate-latest-games.ts",
    "qa:data": "npm run ingest:all && npm run validate:latest-games && npm run lint && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "@prisma/client": "^6.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}