{
  "name": "sports-betting-trends",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "ingest:context": "tsx scripts/ingest-context.ts",
    "ingest:injuries": "tsx scripts/ingest-injuries.ts",
    "ingest:nba-efficiency": "tsx scripts/ingest-nba-efficiency.ts",
    "ingest:ncaa-tournament": "tsx scripts/ingest-ncaa-tournament.ts",
    "ingest:free": "tsx scripts/ingest-free-stats.ts",
    "ingest:odds": "tsx scripts/ingest-odds-api.ts",
    "ingest:props": "tsx scripts/ingest-props.ts",
    "setup:python": "python -m pip install -r scripts/python/requirements.txt && python -m patchright install chromium",
    "backtest:props": "python scripts/python/backtest.py",
    "backtest:model": "tsx scripts/backtest-model.ts",
    "ingest:kalshi": "tsx scripts/ingest-kalshi.ts",
    "autopilot": "tsx scripts/run-kalshi-autopilot.ts",
    "autopilot:ws": "tsx scripts/run-kalshi-autopilot-ws.ts",
    "scrape:ats": "python scripts/python/scrape_ats.py",
    "scrape:consensus": "python scripts/python/scrape_consensus.py",
    "scrape:all": "npm run scrape:ats && npm run scrape:consensus",
    "ingest:all": "npm run ingest:injuries && npm run ingest:nba-efficiency && npm run ingest:context && npm run ingest:odds && npm run scrape:all && npm run ingest:free && npm run ingest:ncaa-tournament && npm run ingest:props && npm run ingest:kalshi",
    "validate:latest-games": "tsx scripts/validate-latest-games.ts",
    "qa:data": "npm run ingest:all && npm run validate:latest-games && npm run lint && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "ws": "^8.18.0",
    "@prisma/client": "^6.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.14",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
