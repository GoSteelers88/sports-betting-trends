# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly LF for code and data
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.env* text eol=lf

# Binary — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary
